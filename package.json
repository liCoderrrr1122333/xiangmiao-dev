{
  "name": "yaochuang-workshop",
  "private": true,
  "version": "1.2.4",
  "description": "耀创工坊 - red-circle locked AI image workflow for ChatGPT and Gemini.",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "author": "hale & hael",
  "engines": { "node": ">=24.14.0" },
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "clean:build": "node scripts/clean-build-output.mjs",
    "build": "npm run clean:build && tsc -b && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.electron.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify:electron-shell": "npm run build && node scripts/verify-electron-shell.mjs",
    "verify:packaged-windows": "node scripts/verify-packaged-windows-compatibility.mjs",
    "verify:startup-notice": "npm run build && node scripts/verify-startup-notice.mjs",
    "verify:face-occlusion": "npm run build && node scripts/verify-face-occlusion-ui.mjs",
    "verify:adaptive-canvas": "npm run build && node scripts/verify-adaptive-canvas-ui.mjs",
    "verify:ui": "npm run build && node scripts/verify-glass-workbench-ui.mjs",
    "verify:result-persistence": "npm run build && node scripts/run-result-persistence-verification.mjs",
    "verify:gemini": "npm run build && node scripts/verify-gemini-page-fixtures.mjs",
    "verify:web-pose-ui": "npm run build && node scripts/verify-web-pose-ui.mjs",
    "verify:chatgpt-models": "npm run build && node scripts/verify-chatgpt-model-page-fixtures.mjs",
    "verify:chatgpt-upload": "npm run build && node scripts/verify-chatgpt-upload-page-fixtures.mjs",
    "verify:chatgpt-upload-live": "npm run build && node scripts/verify-chatgpt-live-attachments.mjs",
    "verify:chatgpt-analysis-live": "npm run build && node scripts/verify-chatgpt-live-analysis.mjs",
    "verify:chatgpt-live": "npm run build && node scripts/verify-chatgpt-live-models.mjs",
    "verify:chatgpt-reasoning-live": "npm run build && node scripts/verify-chatgpt-live-high-reasoning.mjs",
    "verify:relay-resilience": "npm run build && node scripts/verify-relay-resilience.mjs",
    "verify:mac-source": "npm run build && node scripts/verify-macos-source.mjs",
    "verify:packaged-mac": "node scripts/verify-packaged-macos.mjs",
    "verify:gemini-live": "npm run build && node scripts/verify-gemini-live-surface.mjs",
    "verify:chrome": "npm run build && node scripts/verify-chrome-transport-matrix.mjs && node scripts/verify-chrome-window-recovery.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis --config.electronDist=node_modules/electron/dist",
    "dist:mac": "npm run build && node scripts/prepare-macos-icon.mjs && electron-builder --mac dmg"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.34.0",
    "heic-decode": "^2.1.0",
    "jszip": "^3.10.1",
    "playwright-core": "^1.62.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@types/chrome-remote-interface": "^0.31.14",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.22.0",
    "nanoid": "^5.1.16",
    "oxlint": "^1.71.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wait-on": "^9.0.10",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "studio.yaochuang.workshop",
    "asar": false,
    "icon": "build/icon.ico",
    "productName": "耀创工坊",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "public/yaochuang-tray.png",
        "to": "yaochuang-tray.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Yaochuang-Workshop-${version}-Setup.${ext}"
    },
    "nsis": {
      "guid": "e162eeba-303c-5fe2-92ee-e44a002caae8",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "耀创工坊",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": "dmg",
      "artifactName": "Yaochuang-Workshop-${version}-${arch}.${ext}",
      "category": "public.app-category.graphics-design"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
